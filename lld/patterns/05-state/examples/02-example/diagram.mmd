    direction TB

    class OrderState {
        <<interface>>
        +addItem(Order order, String itemName, double price) void
        +pay(Order order, String paymentTxId) void
        +ship(Order order, String trackingNumber) void
        +deliver(Order order) void
        +cancel(Order order, String reason) void
        +refund(Order order) void
        +getStateName() String
    }

    class CreatedOrderState {
        +addItem(Order order, String itemName, double price) void
        +pay(Order order, String paymentTxId) void
        +ship(Order order, String trackingNumber) void
        +deliver(Order order) void
        +cancel(Order order, String reason) void
        +refund(Order order) void
        +getStateName() String
