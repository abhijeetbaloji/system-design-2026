    class JsonReportBuilder {
        -String title
        -String author
        -String summary
        -List~String~ sectionsJson
        -List~String~ tableJson
        -String footer
        +buildTitle(String title, String author) ReportBuilder
        +buildSummary(String summary) ReportBuilder
        +buildSection(String heading, String content) ReportBuilder
        +buildTable(List~String~ headers, List~List~String~~ rows) ReportBuilder
        +buildFooter(String footerText) ReportBuilder
        +getReport() JsonReport
